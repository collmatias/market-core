# ===========================
# 🐍 PYTHON & CORE
# ===========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
*.log

# ===========================
# 🌍 DJANGO
# ===========================
# Base de datos local por defecto
db.sqlite3
db.sqlite3-journal
*.sqlite3
*.sqlite3.pre_*

# Migrations (recreated from scratch during development)
**/migrations/0*.py
**/migrations/__pycache__/

# Archivos estáticos recolectados (si corres collectstatic)
staticfiles/
backend/staticfiles/

# Archivos subidos por usuarios (nunca se suben al repo)
media/
backend/media/

# Archivos de internacionalización compilados (opcional)
*.mo
*.pot

# ===========================
# 🛡️ MARKETCORE: SEGURIDAD Y LICENCIAS
# ===========================
# Variables de entorno y secretos
.env
.env.*
env/
venv/
.venv/

# Sistema de Licencias (Archivos generados en runtime)
license.key
license_cache.json

# Herramienta de generación de claves (¡SOLO PARA TI!)
# Si subes esto, cualquiera puede generar licencias.
keygen.py

# Backups de la base de datos (generados por la app)
marketcore_backup_*.sqlite3
backups/

# Certificados SSL autogenerados
backend/certs/

# ===========================
# 🐳 DOCKER & VOLÚMENES
# ===========================
# Carpetas de datos mapeadas en docker-compose
postgres_data/
cloud_postgres_data/

# Persistencia de la nube simulada
mock_cloud/db.json

# ===========================
# 📦 BUILD & PYINSTALLER
# ===========================
# Carpetas generadas al compilar el .exe
build/
dist/
*.spec
*.manifest

# ===========================
# 💻 IDE & SISTEMA OPERATIVO
# ===========================
# VS Code, PyCharm, Mac, Windows
.vscode/
.idea/
.DS_Store
Thumbs.db

# Legacy data (Vetter migration source)
Vetter/


# Ignorar migraciones en etapa de desarrollo
backend/*/migrations/0*.py